{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.js",
        "eslint.quality.config.js",
        "vitest.config.ts",
        "scripts/**/*.mjs"
      ],
      "project": ["*.{js,ts}", "scripts/**/*.mjs"],
      "vite": false,
      "vitest": {
        "config": []
      }
    },
    "apps/api": {
      "entry": ["src/server.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/generated/**"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx",
        "src/api/client.ts",
        "vite.config.ts",
        "postcss.config.cjs"
      ],
      "project": ["src/**/*.{ts,tsx}", "*.{ts,cjs}"],
      "ignore": ["src/api/generated/**"],
      "vite": {
        "config": []
      }
    },
    "packages/api-contract": {
      "entry": [],
      "project": [],
      "ignoreDependencies": [
        "@typespec/http",
        "@typespec/openapi",
        "@typespec/openapi3"
      ]
    }
  }
}
